    {
      "id": "l1_inconsistent_different_pop_becomes_different_quantity",
      "description": "03 §4.5–§4.6 / Procedure 4: s3_verdict = INCONSISTENT with s2_same_population = false -> DIFFERENT_QUANTITY",
      "decoded": {
        "s1_what": "A measures baseline cohort size; B measures control subgroup size.",
        "s2_same_population": false,
        "s3_verdict": "INCONSISTENT"
      },
      "expectedVerdict": "DIFFERENT_QUANTITY"
    },
    {
      "id": "l1_inconsistent_same_pop_true_kept",
      "description": "03 §4.6: s3_verdict = INCONSISTENT with s2_same_population = true -> INCONSISTENT",
