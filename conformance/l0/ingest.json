    "id": "tex-depth3-roundtrip-and-bib",
    "op": "ingestLatexProject",
    "input": {
      "isArchive": true,
      "files": {
        "main.tex": "\\documentclass{article}\n\\begin{document}\n% \\input{ignored_comment}\n\\iffalse\n\\input{ignored_iffalse}\n\\fi\nIntro line.\n\\input{sec1}\n\\bibliography{a,b}\n\\end{document}",
        "sec1.tex": "\\section{Methods}\n\\input{sec2}",
        "sec2.tex": "\\input{sec3}",
        "sec3.tex": "Deep finding \\cite{k1,k2}.\nSecond deep line.",
        "a.bib": "@article{k1, author={Ada Lovelace}, title={First Paper}, year={2020}, doi={10.1000/k1}}",
        "b.bib": "@article{k2, author={Alan Turing}, title={Second Paper}, year={2021}, doi={10.1000/k2}}",
        "unused.bib": "@article{k3, title={Should Not Load}}"
      },
      "probeText": "Second deep line."
    },
    "expected": {
      "ok": true,
      "mainFile": "main.tex",
      "documentKind": "multi_file",
      "editable": false,
      "includedFiles": ["sec1.tex", "sec2.tex", "sec3.tex"],
      "bibFilesUsed": ["a.bib", "b.bib"],
      "resolvedKeys": ["k1", "k2"],
      "probeFileLine": { "file": "sec3.tex", "line": 2, "column": 1 },
      "roundTripBackMatches": true
    }
  },
